---
interface Props { name?: 'arrow' | 'close' | 'sun' | 'moon' | 'sliders' | 'pause' | 'play'; }
const { name = 'arrow' } = Astro.props;
---
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'arrow' && <path d="M5 19 19 5M5 5h14v14" />}
  {name === 'close' && <path d="m6 6 12 12M6 18 18 6" />}
  {name === 'sun' && <><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" /></>}
  {name === 'moon' && <path d="M20.5 14A9 9 0 0 1 10 3.5 9 9 0 1 0 20.5 14Z" />}
  {name === 'sliders' && <><path d="M3 7h3m4 0h11M3 17h11m4 0h3" /><circle cx="8" cy="7" r="2" /><circle cx="16" cy="17" r="2" /></>}
  {name === 'pause' && <path d="M8 5v14M16 5v14" />}
  {name === 'play' && <path d="m8 5 11 7-11 7Z" />}
</svg>
