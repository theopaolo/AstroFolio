---
import { projects } from '../data/projects';

// CSS cannot promote each card's custom properties to its parent section.
const paint = (p: (typeof projects)[number]) => [
  `--section-ground:${p.palette[0]}`,
  `--section-shade:${p.palette[2]}`,
  `--section-ink:${p.foreground}`,
  '--coat-strength:1',
].join(';');

const css = [
  '@media (prefers-reduced-motion: no-preference) and (hover: hover) and (pointer: fine){',
  ...projects.map(p => `.projects-section:has(.plate-link[data-project="${p.slug}"]:hover){${paint(p)}}`),
  '}',
].join('\n');
---
<style is:inline set:html={css} />
