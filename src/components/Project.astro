---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { Project } from '../data/projects';
interface Props { project: Project; index: number; }
const { project: p, index } = Astro.props;
---
<li class="project-card" style={`--project-bg:${p.background};--project-ink:${p.foreground}`}>
  <a class="project-link" href={`/projets/${p.slug}/`} data-project={p.slug}>
    <div class="project-image">
      <Image src={p.image} alt={p.imageAlt ?? `Aperçu du site ${p.title}`} widths={[400, 700, 1100]} sizes="(max-width: 650px) 92vw, (max-width: 950px) 46vw, 30vw" format="webp" loading={index < 3 ? 'eager' : 'lazy'} />
      <span class="project-open"><Icon /><span class="visually-hidden">Découvrir le projet</span></span>
    </div>
    <div class="project-caption">
      <div class="cluster" data-justify="between"><h3>{p.title}</h3><span class="project-year">{p.year}</span></div>
      <p>{p.category}</p>
    </div>
  </a>
</li>
