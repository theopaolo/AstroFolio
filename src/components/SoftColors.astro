---
import Icon from './Icon.astro';

const palettes = [
  { value: 'blue', label: 'Bleu', colors: ['#5a60d3', '#dceef8', '#e2e8ff'] },
  { value: 'rose', label: 'Rose', colors: ['#b26caa', '#fff0f5', '#eee0fa'] },
  { value: 'mint', label: 'Vert', colors: ['#548c89', '#e7f6dd', '#d9edee'] },
];
---
<div class="soft-colors" data-soft-colors>
  <canvas class="soft-canvas" aria-hidden="true"></canvas>
  <div class="soft-controls" hidden>
    <div class="soft-set" role="group" aria-label="Palette du fond">
      {palettes.map(({ value, label, colors }) => (
        <label class="soft-swatch" style={colors.map((color, i) => `--c${i + 1}:${color}`).join(';')}>
          <input type="radio" name="soft-palette" value={value} data-colors={colors.join(' ')} checked={value === 'blue'} />
          <span class="visually-hidden">{label}</span>
        </label>
      ))}
    </div>
    <button class="soft-pause" type="button" aria-label="Mettre le fond en pause" aria-pressed="false">
      <span class="soft-pause-icon"><Icon name="pause" /></span>
      <span class="soft-play-icon"><Icon name="play" /></span>
    </button>
  </div>
</div>
<script>
  import '../scripts/soft-colors';
</script>
