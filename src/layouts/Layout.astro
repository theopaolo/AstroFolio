---
import '../styles/site.css';
import Icon from '../components/Icon.astro';
import NamePortrait from '../components/NamePortrait.astro';
interface Props {
  title: string; description?: string; softHero?: boolean; noindex?: boolean;
  image?: { src: string; width: number; height: number; alt: string };
}
const {
  title,
  description = 'Théo Goedert, designer et développeur web à Lyon. Sites internet pour associations, structures culturelles, artistes et PME.',
  softHero = false,
  noindex = false,
  image = { src: '/social.png', width: 1200, height: 630, alt: 'Théo Goedert, design, code et transmission, avec une sélection de projets web.' },
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image.src, Astro.site);
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fff7fb" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/ppfragment-sansregular-webfont.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Théo Goedert" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={image.alt} />
    <slot name="head" />
    <script is:inline>
      try {
        const theme = localStorage.getItem('portfolio-theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body data-soft-hero={softHero || undefined}>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <header class="site-header cluster" data-justify="between">
      <div class="wordmark"><NamePortrait name="Théo Goedert" id="portrait-header" href="/" /></div>
      <nav class="cluster" aria-label="Navigation principale">
        <a href="/#projets">Réalisations</a>
        <a href="/#accompagnement">Approche</a>
        <a class="nav-garden" href="https://shimsham.design/">Shim Sham<Icon /></a>
        <a href="#contact">Contact</a>
        <button class="theme-toggle" type="button" aria-label="Activer le thème sombre" hidden><span class="moon"><Icon name="moon" /></span><span class="sun"><Icon name="sun" /></span></button>
      </nav>
    </header>
    <slot />
    <footer id="contact" class="site-footer">
      <div class="container footer-inner">
        <div class="footer-contact">
          <h2>M’écrire</h2>
          <a class="footer-email" href="mailto:theo@ludique.dev">theo@ludique.dev</a>
        </div>
        <div class="footer-meta cluster" data-justify="between">
          <p>Théo Goedert</p>
          <div class="cluster"><a href="https://github.com/theopaolo">GitHub</a><a href="https://bsky.app/profile/ludique.dev">Bluesky</a><a href="https://www.are.na/theo-paolo/channels">Are.na</a><a href="https://www.instagram.com/theogoedert/">Instagram</a></div>
          <p>Membre du collectif <a href="https://shimsham.design/">Shim Sham</a>.</p>
        </div>
      </div>
    </footer>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
