---
import { Image, getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { projects, type Project } from '../../data/projects';
export function getStaticPaths() {
  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: { project, others: [...projects.slice(index + 1), ...projects.slice(0, index)] },
  }));
}
interface Props { project: Project; others: Project[] }
const { project: p, others } = Astro.props;
const title = `${p.title} : ${p.category} | Théo Goedert`;
const description = `${p.summary} ${p.role} : Théo Goedert.`;
const image = await getImage({ src: p.image, width: 1200, height: 630, fit: 'cover', format: 'jpeg' });
const imageAlt = p.imageAlt ?? `Aperçu du site ${p.title}`;
const siteUrl = new URL('/', Astro.site).href;
const pageUrl = new URL(`/projets/${p.slug}/`, Astro.site).href;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: title,
      description,
      inLanguage: 'fr',
      isPartOf: { '@id': `${siteUrl}#website` },
      mainEntity: { '@id': `${pageUrl}#project` },
      breadcrumb: { '@id': `${pageUrl}#breadcrumb` },
    },
    {
      '@type': 'CreativeWork',
      '@id': `${pageUrl}#project`,
      name: p.title,
      description: p.summary,
      url: p.url,
      image: new URL(image.src, Astro.site).href,
      contributor: { '@type': 'Person', '@id': `${siteUrl}#theo`, name: 'Théo Goedert', url: siteUrl },
      creditText: p.credits.map(credit => `${credit.role} : ${credit.name}`).join('. '),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: siteUrl },
        { '@type': 'ListItem', position: 2, name: p.title, item: pageUrl },
      ],
    },
  ],
};
---
<Layout title={title} description={description} image={{ src: image.src, width: 1200, height: 630, alt: imageAlt }}>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  <main id="contenu" class="project-page">
    <div class="project-opening" data-project-card={p.slug} style={`--project-bg:${p.background};--project-ink:${p.foreground}`}>
      <header class="project-hero" data-vt="ground">
        <div class="container project-hero-inner">
          <a class="back-link" href={`/#${p.slug}`}>Retour aux projets</a>
          <h1 data-vt="title">{p.title}</h1>
          <div class="project-hero-aside">
            <p class="project-lead" data-vt="summary">{p.summary}</p>
            <p class="project-meta" data-vt="note">{[p.category, p.year, p.role].filter(Boolean).join(' / ')}</p>
            {p.url && <a class="text-link" href={p.url} target="_blank" rel="noopener noreferrer">{p.urlLabel ?? 'Visiter le site'}<span class="visually-hidden"> (nouvel onglet)</span><Icon /></a>}
          </div>
          <div class="project-strip" data-vt="bar" aria-hidden="true">
            {p.palette.slice(1).map(colour => <span style={`--patch:${colour}`}></span>)}
          </div>
        </div>
      </header>
      <div class="container">
        <Image class="project-cover" src={p.image} alt={p.imageAlt ?? `Le site ${p.title}`} widths={[600, 1000, 1500]} sizes="(max-width: 1500px) 92vw, 1400px" format="webp" loading="eager" fetchpriority="high" data-vt="print" />
      </div>
    </div>
    <div class="container">
      <div class="project-story">
        <div class="flow"><h2>Le projet</h2>{p.description.map(paragraph => <p>{paragraph}</p>)}{p.reference && <p><a href={p.reference.url}>{p.reference.title}</a></p>}</div>
        <aside><h2>En collaboration</h2><dl>{p.credits.map(credit => <><dt>{credit.role}</dt><dd>{credit.url ? <a href={credit.url}>{credit.name}</a> : credit.name}</dd></>)}</dl></aside>
      </div>
      <nav class="project-rail" aria-labelledby="rail-title">
        <h2 id="rail-title">Les autres projets</h2>
        <ul role="list">
          {others.map(o => (
            <li data-project-card={o.slug} style={`--project-bg:${o.background};--project-ink:${o.foreground}`}>
              <a href={`/projets/${o.slug}/`}>
                <span class="rail-title" data-vt="title">{o.title}<Icon /></span>
                <figure class="rail-ground" data-vt="ground">
                  <div class="rail-frame">
                    <Image src={o.image} alt="" widths={[320, 640]} sizes="260px" format="webp" loading="lazy" data-vt="print" />
                  </div>
                  <figcaption>
                    <div class="rail-note" data-vt="note">{o.category}</div>
                    <div class="rail-bar" data-vt="bar" aria-hidden="true">
                      {o.palette.slice(1).map(colour => <span style={`--patch:${colour}`}></span>)}
                    </div>
                  </figcaption>
                </figure>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </main>
</Layout>
