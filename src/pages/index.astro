---
import Layout from '../layouts/Layout.astro';
import Project from '../components/Project.astro';
import ProjectDialog from '../components/ProjectDialog.astro';
import NamePortrait from '../components/NamePortrait.astro';
import SoftColors from '../components/SoftColors.astro';
import Icon from '../components/Icon.astro';
import { projects } from '../data/projects';
---
<Layout title="Théo Goedert | Design, code et transmission" softHero>
  <main id="contenu">
    <section class="hero" aria-labelledby="intro-title">
      <div class="hero-inner container">
      <div class="hero-intro">
      <h1 id="intro-title" aria-label="Bonjour, moi c’est Théo."><span class="intro-line">Bonjour,</span><span class="intro-line">moi c’est <NamePortrait name="Théo" id="portrait-intro" /><span class="hero-dot">.</span></span></h1>
      <div class="hero-copy">
        <p class="hero-lead">Je suis développeur, designer et enseignant.<br />Je vis à Lyon.</p>
        <p>Je fabrique des sites, des outils et des expériences interactives. Le web est aussi un endroit où j’aime apprendre, expérimenter et me perdre un peu.</p>
      </div>
      </div>
      </div>
      <SoftColors />
    </section>
    <div class="container">
    <section id="projets" class="projects-section" aria-labelledby="projects-title">
      <div class="section-heading"><h2 id="projects-title">Quelques réalisations</h2></div>
      <ul class="project-grid" role="list">{projects.map((project, index) => <Project project={project} index={index} />)}</ul>
    </section>
    <section id="pratique" class="practice-section" aria-labelledby="practice-title">
      <div class="practice-intro"><h2 id="practice-title">Un peu plus sur moi</h2><p>J’ai étudié à l’École supérieure d’art d’Aix-en-Provence, où j’ai obtenu mon DNSEP en 2017. Le code a pris sa place dans ma pratique, à côté de l’image et du son.</p><p>Je garde un intérêt pour les outils qu’on peut comprendre, modifier et partager. L’accessibilité et la sobriété numérique font partie des questions que je me pose en les construisant.</p></div>
      <div class="about-notes">
        <article><h3>Des projets en collectif</h3><p>J’ai cofondé <a href="https://shimsham.design/">Shimsham</a> en 2019. J’y travaille sur des projets web avec des artistes, des designers et des institutions culturelles.</p></article>
        <article><h3>Enseigner</h3><p>J’enseigne le développement web et la création numérique. J’ai notamment donné des cours à Ada Tech School, Eden School, l’Université d’Aix-Marseille et Wild Code School : développement web, net art, podcasts et usages de l’IA.</p></article>
        <article><h3>Et aussi</h3><p>Je mixe et participe à <a href="https://radiozai.com/">Radio ZAI</a>. Avec le collectif RAADIOCAARGO, j’ai mené une résidence art-science au GIPSA-Lab, autour du son et de la perception. La photographie, la science-fiction et les promenades sur le web ne sont jamais très loin.</p></article>
      </div>
    </section>
    <section class="elsewhere-section" aria-labelledby="elsewhere-title">
      <div class="section-heading"><h2 id="elsewhere-title">À côté</h2><p>Des outils personnels et des expériences qui suivent mes curiosités.</p></div>
      <div class="grid side-project-grid">
        <a class="elsewhere-link" href="https://colorcatchers.co/"><div class="cluster" data-justify="between"><h3>Color Catchers</h3><Icon /></div><p>Un outil pour extraire des palettes de couleurs à partir de photos, les garder et les partager.</p><span>colorcatchers.co</span></a>
        <a class="elsewhere-link" href="https://promissansfautes.fr/"><div class="cluster" data-justify="between"><h3>Promis Sans Fautes</h3><Icon /></div><p>Un éditeur et correcteur de texte pensé pour les personnes dyslexiques et dysorthographiques.</p><span>promissansfautes.fr</span></a>
        <a class="elsewhere-link" href="https://softcolors.ludique.dev/"><div class="cluster" data-justify="between"><h3>Soft Colors</h3><Icon /></div><p>Une petite expérience autour des dégradés, des textures et du mouvement. On change les réglages et on regarde ce qui se passe.</p><span>softcolors.ludique.dev</span></a>
      </div>
      <div class="grid elsewhere-grid">
        <a class="elsewhere-link" href="https://jardin.ludique.dev/"><div class="cluster" data-justify="between"><h3>Le jardin numérique</h3><Icon /></div><p>Mes notes, mes lectures et mes dérives sur le web. Les idées y restent parfois inachevées, et j’y reviens à mon rythme.</p><span>jardin.ludique.dev</span></a>
        <a class="elsewhere-link" href="https://github.com/theopaolo/piloti"><div class="cluster" data-justify="between"><h3>Piloti</h3><Icon /></div><p>Le petit framework CSS que je développe et que j’utilise ici. Une manière de garder mes bases de travail lisibles et de les partager.</p><span>Le code sur GitHub</span></a>
      </div>
    </section>
    <section id="contact" class="contact-section" aria-labelledby="contact-title">
      <h2 id="contact-title">M’écrire</h2>
      <a class="contact-email" href="mailto:theo@ludique.dev">theo@ludique.dev</a>
    </section>
    </div>
  </main>
  {projects.map(project => <ProjectDialog project={project} />)}
</Layout>
