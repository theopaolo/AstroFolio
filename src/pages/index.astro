---
import { Image } from 'astro:assets';
import Icon from '../components/Icon.astro';
import NamePortrait from '../components/NamePortrait.astro';
import Project from '../components/Project.astro';
import ProjectTheme from '../components/ProjectTheme.astro';
import SoftColors from '../components/SoftColors.astro';
import { projects } from '../data/projects';
import Layout from '../layouts/Layout.astro';
import apses from '../images/apses.png';

const title = 'Développeur web et designer à Lyon | Théo Goedert';
const siteUrl = new URL('/', Astro.site).href;
const personId = `${siteUrl}#theo`;
const websiteId = `${siteUrl}#website`;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: 'Théo Goedert',
      url: siteUrl,
      jobTitle: ['Développeur web', 'Designer'],
      homeLocation: { '@type': 'City', name: 'Lyon' },
      email: 'theo@ludique.dev',
      sameAs: [
        'https://github.com/theopaolo',
        'https://bsky.app/profile/ludique.dev',
        'https://www.are.na/theo-paolo/channels',
        'https://www.instagram.com/theogoedert/',
      ],
      memberOf: { '@type': 'Organization', name: 'Shim Sham', url: 'https://shimsham.design/' },
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: siteUrl,
      name: 'Théo Goedert',
      inLanguage: 'fr',
      author: { '@id': personId },
    },
    {
      '@type': 'ProfilePage',
      '@id': `${siteUrl}#webpage`,
      url: siteUrl,
      name: title,
      inLanguage: 'fr',
      isPartOf: { '@id': websiteId },
      mainEntity: { '@id': personId },
    },
  ],
};

const ongoing = [
  { title: 'APSES', url: 'https://apses.ludique.dev/', image: apses, status: 'En préproduction', tilt: 1.6,
    summary: 'Refonte du site de l’Association des professeurs de sciences économiques et sociales.',
    background: '#e8e5fa', foreground: '#3b2a8f' },
];

// Color Catchers and GitHub block framing, so their previews use screenshots.
const sidequests = [
  { title: 'Soft Colors', url: 'https://softcolors.ludique.dev/', label: 'softcolors.ludique.dev', image: 'soft-colors', frame: true,
    summary: 'Un outil pour composer des dégradés et des textures animées.',
    background: '#6670d8', foreground: '#eef0ff' },
  { title: 'Audiosphere', url: 'https://audiosphere.vercel.app/', label: 'audiosphere.vercel.app', image: 'audiosphere', frame: true,
    summary: 'Une sphère en 3D qui réagit au son. Un clic lance l’écoute et anime les particules qui l’entourent. Avec un texte de Jean Baudrillard, <em>Simulacres et simulation</em>.',
    background: '#182838', foreground: '#c9e6ea' },
  { title: 'Sound01', url: 'https://sound01.netlify.app/', label: 'sound01.netlify.app', image: 'sound01', frame: true,
    summary: 'Une pièce sonore générative à écouter dans le navigateur, inspirée de Ryoji Ikeda.',
    background: '#0c0c0c', foreground: '#e9c46a' },
  { title: 'Color Catchers', url: 'https://app.colorcatchers.co/', label: 'app.colorcatchers.co', image: 'color-catchers', frame: false,
    summary: 'Un outil pour extraire des palettes de couleurs du monde réel et contribuer à une archive collective.',
    background: '#262626', foreground: '#f4a259' },
  { title: 'Promis Sans Fautes', url: 'https://promissansfautes.fr/', label: 'promissansfautes.fr', image: 'promis-sans-fautes', frame: true,
    summary: 'Un éditeur et correcteur de texte pensé pour les personnes dyslexiques et dysorthographiques.',
    background: '#e3ebf1', foreground: '#1e2b38' },
  { title: 'Le jardin numérique', url: 'https://jardin.ludique.dev/', label: 'jardin.ludique.dev', image: 'jardin', frame: true,
    summary: 'Mes notes, idées et dérives sur le web.',
    background: '#fbeef6', foreground: '#5c4b75' },
  { title: 'Piloti', url: 'https://github.com/theopaolo/piloti', label: 'Le code sur GitHub', image: 'piloti', frame: false,
    summary: 'Une base de styles réutilisable pour construire mes interfaces web.',
    background: '#eef5ef', foreground: '#1f6b3a' },
];
const tilts = [-2.4, 1.8, -1.2, 2.6, -1.9, 1.4, -2.8];
---
<Layout title={title} softHero>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  <main id="contenu">
    <section class="hero" aria-labelledby="intro-title">
      <div class="hero-inner container">
      <div class="hero-intro">
      <h1 id="intro-title"><span class="intro-line">Salut,</span><span class="intro-line">moi c’est <NamePortrait name="Théo" id="portrait-intro" /><span class="hero-dot">.</span></span></h1>
      <div class="hero-copy">
        <p class="hero-lead">Designer et développeur web à Lyon, je crée des sites, des outils et des expériences interactives.</p>
      </div>
      </div>
      </div>
      <SoftColors />
    </section>
    <section id="accompagnement" class="practice-section" aria-labelledby="practice-title">
      <div class="container">
        <h2 id="practice-title">Design et développement web</h2>
        <div class="practice-grid">
          <p class="practice-lead">Je conçois des sites internet rapides et simples d’utilisation. L’apparence et l’expérience comptent tout autant que la qualité et la robustesse du code.</p>
          <div class="practice-body flow">
            <p>J’accompagne des associations, des structures culturelles, des artistes et des PME, à Lyon comme à distance. La plupart de ces projets se construisent au sein de <a href="https://shimsham.design/">Shim Sham</a>, mon collectif de direction artistique et de création numérique, qui réunit les compétences de plusieurs collaborateurs selon les besoins.</p>
            <p>Je contribue doucement à <a href="https://joinmobilizon.org/">Mobilizon</a>, une alternative libre à Facebook pour organiser des événements et animer des groupes.</p>
            <p>Enfin, j’aime transmettre ce métier : j’interviens dans des écoles, à l’université et en centre de formation.</p>
          </div>
        </div>
      </div>
    </section>
    <section id="projets" class="projects-section" aria-labelledby="projects-title">
      <ProjectTheme />
      <div class="container">
      <div class="section-heading"><h2 id="projects-title">Réalisations</h2></div>
      <ul class="project-grid" role="list">{projects.map((project, index) => <Project project={project} index={index} />)}</ul>
      </div>
    </section>
    <section id="en-cours" class="ongoing-section" aria-labelledby="ongoing-title">
      <div class="container">
      <div class="section-heading"><h2 id="ongoing-title">Sur le feu</h2><p>Des commandes en cours, déjà consultables en préproduction.</p></div>
      <ul class="ongoing-list" role="list">
        {ongoing.map(o => (
          <li class="sidequest-card" style={`--card-bg:${o.background};--card-ink:${o.foreground};--card-tilt:${o.tilt}deg`}>
            <a class="sidequest-link" href={o.url}>
              <Image class="sidequest-preview" src={o.image} alt="" widths={[320, 640]} sizes="(max-width: 650px) 6rem, 20rem" format="webp" loading="lazy" />
              <div class="cluster" data-justify="between"><h3>{o.title}</h3><Icon /></div>
              <p>{o.summary}</p>
              <span>{o.status}</span>
            </a>
          </li>
        ))}
      </ul>
      </div>
    </section>
    <section id="sidequests" class="elsewhere-section" aria-labelledby="elsewhere-title">
      <div class="container">
      <div class="section-heading"><h2 id="elsewhere-title">Explorations</h2><p>Des outils maison et des expériences autour de la couleur, du son et de la lecture.</p></div>
      <div class="sidequest-table" data-sidequests>
        <ul class="sidequest-hand" role="list">
          {sidequests.map((s, i) => (
            <li class="sidequest-card" style={`--card-bg:${s.background};--card-ink:${s.foreground};--card-tilt:${tilts[i]}deg`}>
              <a class="sidequest-link" href={s.url} data-sidequest>
                <img class="sidequest-preview" src={`/images/side-projects/${s.image}.webp`} width="640" height="400" alt="" loading="lazy" decoding="async" />
                <div class="cluster" data-justify="between"><h3>{s.title}</h3><Icon /></div>
                <p set:html={s.summary} />
                <span>{s.label}</span>
              </a>
            </li>
          ))}
        </ul>
        {/* The cards remain the links; the mirrored stage is presentational. */}
        <div class="sidequest-stage" inert>
          {sidequests.map((s, i) => (
            <figure class="stage-figure" data-live={i === 0 ? '' : undefined}>
              <div class="stage-window">
                {s.frame
                  ? <iframe data-src={s.url} title={s.title} sandbox="allow-scripts allow-same-origin"></iframe>
                  : <img src={`/images/side-projects/${s.image}.webp`} width="640" height="400" alt="" loading="lazy" decoding="async" />}
              </div>
              <figcaption><span set:html={s.summary} /><span class="stage-domain">{s.label}</span></figcaption>
            </figure>
          ))}
        </div>
      </div>
      </div>
    </section>
  </main>
</Layout>
