---
import Icon from '../components/Icon.astro';
import NamePortrait from '../components/NamePortrait.astro';
import Project from '../components/Project.astro';
import ProjectTheme from '../components/ProjectTheme.astro';
import SoftColors from '../components/SoftColors.astro';
import { projects } from '../data/projects';
import Layout from '../layouts/Layout.astro';

// Color Catchers and GitHub block framing, so their previews use screenshots.
const sidequests = [
  { title: 'Soft Colors', url: 'https://softcolors.ludique.dev/', label: 'softcolors.ludique.dev', image: 'soft-colors', frame: true,
    summary: 'Une application à côté de Color Catchers pour fabriquer des dégradés, des textures et du mouvement.',
    background: '#6670d8', foreground: '#eef0ff' },
  { title: 'Audiosphere', url: 'https://audiosphere.vercel.app/', label: 'audiosphere.vercel.app', image: 'audiosphere', frame: true,
    summary: 'Une sphère en 3D qui réagit au son. Un clic lance l’écoute et anime les particules qui l’entourent. Avec un texte de Jean Baudrillard, <em>Simulacres et simulation</em>.',
    background: '#182838', foreground: '#c9e6ea' },
  { title: 'Sound01', url: 'https://sound01.netlify.app/', label: 'sound01.netlify.app', image: 'sound01', frame: true,
    summary: 'Une pièce sonore générative à écouter dans le navigateur, inspirée de Ryoji Ikeda.',
    background: '#0c0c0c', foreground: '#e9c46a' },
  { title: 'Color Catchers', url: 'https://app.colorcatchers.co/', label: 'app.colorcatchers.co', image: 'color-catchers', frame: false,
    summary: 'Un outil pour extraire des palettes de couleurs du monde réel et contribuer à une archive collective.',
    background: '#262626', foreground: '#f4a259' },
  { title: 'Promis Sans Fautes', url: 'https://promissansfautes.fr/', label: 'promissansfautes.fr', image: 'promis-sans-fautes', frame: true,
    summary: 'Un éditeur et correcteur de texte pensé pour les personnes dyslexiques et dysorthographiques.',
    background: '#e3ebf1', foreground: '#1e2b38' },
  { title: 'Le jardin numérique', url: 'https://jardin.ludique.dev/', label: 'jardin.ludique.dev', image: 'jardin', frame: true,
    summary: 'Mes notes, idées et dérives sur le web.',
    background: '#fbeef6', foreground: '#5c4b75' },
  { title: 'Piloti', url: 'https://github.com/theopaolo/piloti', label: 'Le code sur GitHub', image: 'piloti', frame: false,
    summary: 'Mon framework CSS, basé sur la méthodologie CUBE CSS.',
    background: '#eef5ef', foreground: '#1f6b3a' },
];
const tilts = [-2.4, 1.8, -1.2, 2.6, -1.9, 1.4, -2.8];
---
<Layout title="Théo Goedert | Design, code et transmission" softHero>
  <main id="contenu">
    <section class="hero" aria-labelledby="intro-title">
      <div class="hero-inner container">
      <div class="hero-intro">
      <h1 id="intro-title"><span class="intro-line">Salut !</span><span class="intro-line">moi c’est <NamePortrait name="Théo" id="portrait-intro" /><span class="hero-dot">.</span></span></h1>
      <div class="hero-copy">
        <p class="hero-lead">Bienvenue sur mon site ! Ici, je partage mes réalisations, mes outils et quelques expérimentations, mêlant code, textes et couleurs.</p>
      </div>
      </div>
      </div>
      <SoftColors />
    </section>
    <section id="projets" class="projects-section" aria-labelledby="projects-title">
      <ProjectTheme />
      <div class="container">
      <div class="section-heading"><h2 id="projects-title">Selection de projets</h2></div>
      <ul class="project-grid" role="list">{projects.map((project, index) => <Project project={project} index={index} />)}</ul>
      </div>
    </section>
    <section id="pratique" class="practice-section" aria-labelledby="practice-title">
      <div class="container practice-grid">
      <div class="practice-intro"><h2 id="practice-title">Approches</h2>
        <p>Travailler dans la tech c'est aussi participer à des coûts écologique importants. Dans ce sens j'esssai de faire au mieux pour en reduire l'impact en favorisant des architecture simple, maintenable et robust.</p>
        <p>Je m'intéresse à l'autonomie du web et contribue à des projets open-sources.</p>
      </div>
      <div class="about-notes flow">
        <p>Avec <a href="https://shimsham.design/">Shimsham</a>, on travaille sur des projets pour associations, institutions culturelles, festivals, artistes, pme.</p>
        <article><h3>Transmettre</h3><p>Je transmets mes passions pour le développement web et la création numérique en école, à la fac et en centre de formation.</p></article>
      </div>
      </div>
    </section>
    <section class="elsewhere-section" aria-labelledby="elsewhere-title">
      <div class="container">
      <div class="section-heading"><h2 id="elsewhere-title">Sidequests</h2><p>J’entretiens plusieurs projets annexes : des outils personnels et des expériences interactives.</p></div>
      <div class="sidequest-table" data-sidequests>
        <ul class="sidequest-hand" role="list">
          {sidequests.map((s, i) => (
            <li class="sidequest-card" style={`--card-bg:${s.background};--card-ink:${s.foreground};--card-tilt:${tilts[i]}deg`}>
              <a class="sidequest-link" href={s.url} data-sidequest>
                <img class="sidequest-preview" src={`/images/side-projects/${s.image}.webp`} width="640" height="400" alt="" loading="lazy" decoding="async" />
                <div class="cluster" data-justify="between"><h3>{s.title}</h3><Icon /></div>
                <p set:html={s.summary} />
                <span>{s.label}</span>
              </a>
            </li>
          ))}
        </ul>
        {/* The cards remain the links; the mirrored stage is presentational. */}
        <div class="sidequest-stage" inert>
          {sidequests.map((s, i) => (
            <figure class="stage-figure" data-live={i === 0 ? '' : undefined}>
              <div class="stage-window">
                {s.frame
                  ? <iframe data-src={s.url} title={s.title} sandbox="allow-scripts allow-same-origin"></iframe>
                  : <img src={`/images/side-projects/${s.image}.webp`} width="640" height="400" alt="" loading="lazy" decoding="async" />}
              </div>
              <figcaption><span set:html={s.summary} /><span class="stage-domain">{s.label}</span></figcaption>
            </figure>
          ))}
        </div>
      </div>
      </div>
    </section>
    <section id="contact" class="contact-section" aria-labelledby="contact-title">
      <div class="container cluster contact-inner">
        <h2 id="contact-title">M’écrire</h2>
        <a class="contact-email" href="mailto:theo@ludique.dev">theo@ludique.dev</a>
      </div>
    </section>
  </main>
</Layout>
