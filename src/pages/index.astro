---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import Icon from '../components/Icon.astro';
import NamePortrait from '../components/NamePortrait.astro';
import Project from '../components/Project.astro';
import ProjectTheme from '../components/ProjectTheme.astro';
import SoftColors from '../components/SoftColors.astro';
import { projects } from '../data/projects';
import Layout from '../layouts/Layout.astro';

const home = await getEntry('home', 'home');
if (!home) throw new Error('src/content/home.md is missing');
const { Content: Practice } = await render(home);
const { title, lead, practice, projects: projectsCopy, ongoing, sidequests, friends } = home.data;

const siteUrl = new URL('/', Astro.site).href;
const personId = `${siteUrl}#theo`;
const websiteId = `${siteUrl}#website`;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: 'Théo Goedert',
      url: siteUrl,
      jobTitle: ['Développeur web', 'Designer'],
      homeLocation: { '@type': 'City', name: 'Lyon' },
      email: 'theo@ludique.dev',
      sameAs: [
        'https://github.com/theopaolo',
        'https://bsky.app/profile/ludique.dev',
        'https://www.are.na/theo-paolo/channels',
        'https://www.instagram.com/theogoedert/',
      ],
      memberOf: { '@type': 'Organization', name: 'shimsham', url: 'https://shimsham.design/' },
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: siteUrl,
      name: 'Théo Goedert',
      inLanguage: 'fr',
      author: { '@id': personId },
    },
    {
      '@type': 'ProfilePage',
      '@id': `${siteUrl}#webpage`,
      url: siteUrl,
      name: title,
      inLanguage: 'fr',
      isPartOf: { '@id': websiteId },
      mainEntity: { '@id': personId },
    },
  ],
};

const tilts = [-2.4, 1.8, -1.2, 2.6, -1.9, 1.4, -2.8, 2.2];
const tilt = (i: number) => tilts[i % tilts.length];
---
<Layout title={title} softHero>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  <main id="contenu">
    <section class="hero" aria-labelledby="intro-title">
      <div class="hero-inner container">
        <h1 id="intro-title">Salut,<br />moi c’est <NamePortrait name="Théo" id="portrait-intro" /><span class="hero-dot">.</span></h1>
        <p class="hero-lead">{lead}</p>
      </div>
      <SoftColors />
    </section>
    <section id="accompagnement" class="practice-section" aria-labelledby="practice-title">
      <div class="container">
        <h2 id="practice-title">{practice.title}</h2>
        <div class="practice-grid">
          <p class="practice-lead">{practice.lead}</p>
          <div class="practice-body flow"><Practice /></div>
        </div>
      </div>
    </section>
    <section id="projets" class="projects-section" aria-labelledby="projects-title">
      <ProjectTheme />
      <div class="container">
        <header class="section-heading"><h2 id="projects-title">{projectsCopy.title}</h2></header>
        <ul class="project-grid" role="list">{projects.map((project, index) => <Project project={project} index={index} />)}</ul>
      </div>
    </section>
    <section id="en-cours" class="ongoing-section" aria-labelledby="ongoing-title">
      <div class="container">
        <header class="section-heading"><h2 id="ongoing-title">{ongoing.title}</h2><p>{ongoing.intro}</p></header>
        <ul class="ongoing-list" role="list">
          {ongoing.items.map((o, i) => (
            <li class="sidequest-card" style={`--card-bg:${o.background};--card-ink:${o.foreground};--card-tilt:${-tilt(i)}deg`}>
              <a class="sidequest-link" href={o.url}>
                <Image class="sidequest-preview" src={o.image} alt="" widths={[320, 640]} sizes="(max-width: 650px) 6rem, 20rem" format="webp" loading="lazy" />
                <h3>{o.title}<Icon /></h3>
                <p>{o.summary}</p>
                <span>{o.status}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
    <section id="sidequests" class="elsewhere-section" aria-labelledby="elsewhere-title">
      <div class="container">
        <header class="section-heading"><h2 id="elsewhere-title">{sidequests.title}</h2><p>{sidequests.intro}</p></header>
        <div class="sidequest-table" data-sidequests>
          <ul class="sidequest-hand" role="list">
            {sidequests.items.map((s, i) => (
              <li class="sidequest-card" style={`--card-bg:${s.background};--card-ink:${s.foreground};--card-tilt:${tilt(i)}deg`}>
                <a class="sidequest-link" href={s.url} data-sidequest>
                  <img class="sidequest-preview" src={s.image} width="640" height="400" alt="" loading="lazy" decoding="async" />
                  <h3>{s.title}<Icon /></h3>
                  <p set:html={s.summary} />
                  <span>{s.label ?? new URL(s.url).host}</span>
                </a>
              </li>
            ))}
          </ul>
          {/* The cards remain the links; the mirrored stage is presentational. */}
          <div class="sidequest-stage" inert>
            {sidequests.items.map((s, i) => (
              <figure class="stage-figure" data-live={i === 0 ? '' : undefined}>
                <div class="stage-window">
                  {s.embed
                    ? <iframe data-src={s.url} title={s.title} sandbox="allow-scripts allow-same-origin"></iframe>
                    : <img src={s.image} width="640" height="400" alt="" loading="lazy" decoding="async" />}
                </div>
                <figcaption><span set:html={s.summary} /><span class="stage-domain">{s.label ?? new URL(s.url).host}</span></figcaption>
              </figure>
            ))}
          </div>
        </div>
      </div>
    </section>
    <section id="voisinage" class="friends-section" aria-labelledby="friends-title">
      <div class="container">
        <header class="section-heading"><h2 id="friends-title">{friends.title}</h2><p>{friends.intro}</p></header>
        <ul class="friends-list" role="list">
          {friends.items.map(f => <li><a href={f.url}>{f.name}</a> <span>{new URL(f.url).host.replace(/^www\./, '')}</span></li>)}
        </ul>
      </div>
    </section>
  </main>
</Layout>
