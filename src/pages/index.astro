---
import Icon from '../components/Icon.astro';
import NamePortrait from '../components/NamePortrait.astro';
import Project from '../components/Project.astro';
import ProjectTheme from '../components/ProjectTheme.astro';
import SoftColors from '../components/SoftColors.astro';
import { projects } from '../data/projects';
import Layout from '../layouts/Layout.astro';
---
<Layout title="Théo Goedert | Design, code et transmission" softHero>
  <main id="contenu">
    <section class="hero" aria-labelledby="intro-title">
      <div class="hero-inner container">
      <div class="hero-intro">
      <h1 id="intro-title"><span class="intro-line">Salut !</span><span class="intro-line">moi c’est <NamePortrait name="Théo" id="portrait-intro" /><span class="hero-dot">.</span></span></h1>
      <div class="hero-copy">
        <p class="hero-lead">Bienvenue sur mon site ! Ici, je partage mes réalisations, mes outils et quelques expérimentations, mêlant code, textes et couleurs.</p>
      </div>
      </div>
      </div>
      <SoftColors />
    </section>
    <section id="projets" class="projects-section" aria-labelledby="projects-title">
      <ProjectTheme />
      <div class="container">
      <div class="section-heading"><h2 id="projects-title">Selection de projets</h2></div>
      <ul class="project-grid" role="list">{projects.map((project, index) => <Project project={project} index={index} />)}</ul>
      </div>
    </section>
    <section id="pratique" class="practice-section" aria-labelledby="practice-title">
      <div class="container practice-grid">
      <div class="practice-intro"><h2 id="practice-title">Approches</h2>
        <p>Travailler dans la tech c'est aussi participer à des coûts écologique importants. Dans ce sens j'esssai de faire au mieux pour en reduire l'impact en favorisant des architecture simple, maintenable et robust.</p>
        <p>Je m'intéresse à l'autonomie du web et contribue à des projets open-sources.</p>
      </div>
      <div class="about-notes flow">
        <p>Avec <a href="https://shimsham.design/">Shimsham</a>, on travaille sur des projets pour associations, institutions culturelles, festivals, artistes, pme.</p>
        <article><h3>Transmettre</h3><p>Je transmets mes passions pour le développement web et la création numérique en école, à la fac et en centre de formation.</p></article>
      </div>
      </div>
    </section>
    <section class="elsewhere-section" aria-labelledby="elsewhere-title">
      <div class="container">
      <div class="section-heading"><h2 id="elsewhere-title">Sidequests</h2><p>J’entretiens plusieurs projets annexes : des outils personnels et des expériences interactives.</p></div>
      <div class="grid side-project-grid">
        <a class="elsewhere-link" href="https://app.colorcatchers.co/"><img class="elsewhere-preview" src="/images/side-projects/color-catchers.webp" width="640" height="400" alt="" loading="lazy" decoding="async" /><div class="cluster" data-justify="between"><h3>Color Catchers</h3><Icon /></div><p>Un outil pour extraire des palettes de couleurs du monde réel et contribuer à une archive collective.</p><span>app.colorcatchers.co</span></a>
        <a class="elsewhere-link" href="https://promissansfautes.fr/"><img class="elsewhere-preview" src="/images/side-projects/promis-sans-fautes.webp" width="640" height="400" alt="" loading="lazy" decoding="async" /><div class="cluster" data-justify="between"><h3>Promis Sans Fautes</h3><Icon /></div><p>Un éditeur et correcteur de texte pensé pour les personnes dyslexiques et dysorthographiques.</p><span>promissansfautes.fr</span></a>
        <a class="elsewhere-link" href="https://softcolors.ludique.dev/"><img class="elsewhere-preview" src="/images/side-projects/soft-colors.webp" width="640" height="400" alt="" loading="lazy" decoding="async" /><div class="cluster" data-justify="between"><h3>Soft Colors</h3><Icon /></div><p>Une application à côté de Color Catchers pour fabriquer des dégradés, des textures et du mouvement.</p><span>softcolors.ludique.dev</span></a>
      </div>
      <div class="grid side-project-grid">
        <a class="elsewhere-link" href="https://audiosphere.vercel.app/"><img class="elsewhere-preview" src="/images/side-projects/audiosphere.webp" width="640" height="400" alt="" loading="lazy" decoding="async" /><div class="cluster" data-justify="between"><h3>Audiosphere</h3><Icon /></div><p>Une sphère en 3D qui réagit au son. Un clic lance l’écoute et anime les particules qui l’entourent. Avec un texte de Jean Baudrillard, <em>Simulacres et simulation</em>.</p><span>audiosphere.vercel.app</span></a>
        <a class="elsewhere-link" href="https://sound01.netlify.app/"><img class="elsewhere-preview" src="/images/side-projects/sound01.webp" width="640" height="400" alt="" loading="lazy" decoding="async" /><div class="cluster" data-justify="between"><h3>Sound01</h3><Icon /></div><p>Une pièce sonore générative à écouter dans le navigateur, inspirée de Ryoji Ikeda.</p><span>sound01.netlify.app</span></a>
      </div>
      <div class="grid elsewhere-grid">
        <a class="elsewhere-link" href="https://jardin.ludique.dev/"><img class="elsewhere-preview" src="/images/side-projects/jardin.webp" width="640" height="400" alt="" loading="lazy" decoding="async" /><div class="cluster" data-justify="between"><h3>Le jardin numérique</h3><Icon /></div><p>Mes notes, idées et dérives sur le web.</p><span>jardin.ludique.dev</span></a>
        <a class="elsewhere-link" href="https://github.com/theopaolo/piloti"><img class="elsewhere-preview" src="/images/side-projects/piloti.webp" width="640" height="400" alt="" loading="lazy" decoding="async" /><div class="cluster" data-justify="between"><h3>Piloti</h3><Icon /></div><p>Mon framework CSS, basé sur la méthodologie CUBE CSS.</p><span>Le code sur GitHub</span></a>
      </div>
      </div>
    </section>
    <section id="contact" class="contact-section" aria-labelledby="contact-title">
      <div class="container cluster contact-inner">
        <h2 id="contact-title">M’écrire</h2>
        <a class="contact-email" href="mailto:theo@ludique.dev">theo@ludique.dev</a>
      </div>
    </section>
  </main>
</Layout>
